rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Farmer applicants & harvest registrations
    match /applicants/{applicantId} {
      allow read: if true;
      allow create: if isValidId(applicantId) &&
        request.resource.data.farmerName is string &&
        request.resource.data.farmerName.size() > 0 &&
        request.resource.data.farmerName.size() <= 100 &&
        request.resource.data.phoneNumber is string &&
        request.resource.data.phoneNumber.size() <= 20 &&
        request.resource.data.cropName is string &&
        request.resource.data.quantityTonnes is number &&
        request.resource.data.quantityTonnes > 0 &&
        request.resource.data.quantityTonnes <= 1000;
      allow update: if isValidId(applicantId) &&
        request.resource.data.farmerName is string &&
        request.resource.data.quantityTonnes is number;
      allow delete: if false;
    }

    // Mandi stores and storage facility specifications
    match /mandi_stores/{storeId} {
      allow read: if true;
      allow create, update: if isValidId(storeId) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 150 &&
        request.resource.data.district is string &&
        request.resource.data.totalCapacityTonnes is number &&
        request.resource.data.totalCapacityTonnes >= 0;
      allow delete: if false;
    }

    // Admin history and audit trail (append-only immutable logs)
    match /admin_history/{logId} {
      allow read: if true;
      allow create: if isValidId(logId) &&
        request.resource.data.actionType is string &&
        request.resource.data.entityName is string &&
        request.resource.data.adminUser is string &&
        request.resource.data.summary is string &&
        request.resource.data.summary.size() <= 500;
      allow update, delete: if false;
    }
  }
}
